# Normalize line endings to LF in the repo, native on checkout
* text=auto

# Force LF for files that must not have CRLF
*.py text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Force CRLF for Windows-only files
*.bat text eol=crlf

# Binary files (don't touch)
*.pptx binary
*.xlsx binary
*.xls binary
*.png binary
*.jpg binary
*.jpeg binary
